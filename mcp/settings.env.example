# 与根目录 .env 一起传给 Compose；实际 settings.env 不要提交。
HELIX_MCP_PUBLIC_BASE_URL=https://helix-mcp.example.com
HELIX_MCP_OWNER_ID=replace-with-trusted-owner-id
HELIX_MCP_WORKSPACE_ID=replace-with-trusted-workspace-id
HELIX_MCP_ALLOWED_REDIRECT_URIS='["https://chatgpt.com/connector/oauth/*","https://chatgpt.com/connector_platform_oauth_redirect","http://127.0.0.1:*","http://localhost:*"]'
